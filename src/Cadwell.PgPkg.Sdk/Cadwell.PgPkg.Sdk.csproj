<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Cadwell.PgPkg.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Description>MSBuild SDK for building PostgreSQL desired-state deployment packages (.pgpkg)</Description>
    <PackageTags>postgres;postgresql;pgschema;dacpac;sdk;msbuild</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk\Sdk.props"   Pack="true" PackagePath="Sdk\Sdk.props" />
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk\Sdk.targets" />
    <None Include="build\Cadwell.PgPkg.Sdk.props"   Pack="true" PackagePath="build\Cadwell.PgPkg.Sdk.props" />
    <None Include="build\Cadwell.PgPkg.Sdk.targets" Pack="true" PackagePath="build\Cadwell.PgPkg.Sdk.targets" />
  </ItemGroup>

</Project>
