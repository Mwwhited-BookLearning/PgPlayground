<Project>
  <PropertyGroup>
    <CadwellPgPkgSdkPropsImported>true</CadwellPgPkgSdkPropsImported>

    <!-- MSBuild doesn't define these without Microsoft.NET.Sdk; provide safe defaults -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">obj\$(Configuration)\</IntermediateOutputPath>

    <!-- Default database name to the MSBuild project name if not set -->
    <DatabaseName Condition="'$(DatabaseName)' == ''">$(MSBuildProjectName)</DatabaseName>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>

    <!-- Output: a .pgpkg file written under OutputPath -->
    <PgPkgOutputPath Condition="'$(PgPkgOutputPath)' == ''">$(OutputPath)</PgPkgOutputPath>
    <PgPkgFileName Condition="'$(PgPkgFileName)' == ''">$(MSBuildProjectName)-$(Version).pgpkg</PgPkgFileName>
    <PgPkgFilePath>$(PgPkgOutputPath)$(PgPkgFileName)</PgPkgFilePath>

    <!-- Schema folder inside the archive -->
    <PgPkgSchemaRoot>schema/$(DatabaseName)</PgPkgSchemaRoot>
  </PropertyGroup>

  <!-- Default glob: any .sql or .pgschema file under the project.
       Set EnableDefaultPgSchemaItems=false to opt out (e.g. when a target generates schema). -->
  <ItemGroup Condition="'$(EnableDefaultPgSchemaItems)' != 'false'">
    <PgSchema Include="**\*.sql;**\*.pgschema"
              Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);obj\**;bin\**" />
  </ItemGroup>
</Project>
