<Project>
  <PropertyGroup>
    <OoBDevPgPkgSdkPropsImported>true</OoBDevPgPkgSdkPropsImported>

    <!--
      Projects using this SDK must set DefaultTargets="Build" on their <Project> element.
      MSBuild does not automatically use the first imported target when DefaultTargets is absent;
      any user-defined target in the project file would otherwise become the default entry point.
    -->

    <!-- MSBuild doesn't define these without Microsoft.NET.Sdk; provide safe defaults -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">obj\$(Configuration)\</IntermediateOutputPath>

    <!-- Defaults for user-overridable properties; evaluated early so users can build on them -->
    <DatabaseName Condition="'$(DatabaseName)' == ''">$(MSBuildProjectName)</DatabaseName>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
  </PropertyGroup>

  <!-- Default glob: any .sql or .pgschema file under the project.
       Set EnableDefaultPgSchemaItems=false to opt out (e.g. when a target generates schema). -->
  <ItemGroup Condition="'$(EnableDefaultPgSchemaItems)' != 'false'">
    <PgSchema Include="**\*.sql;**\*.pgschema"
              Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);obj\**;bin\**" />
  </ItemGroup>
</Project>
