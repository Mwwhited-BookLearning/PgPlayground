<Project>
  <PropertyGroup>
    <OoBDevPgPkgSdkTargetsImported>true</OoBDevPgPkgSdkTargetsImported>

    <!--
      Derived output properties live here so they evaluate AFTER the project
      file's own <PropertyGroup> blocks see the user's overrides.
    -->
    <PgPkgOutputPath Condition="'$(PgPkgOutputPath)' == ''">$(OutputPath)</PgPkgOutputPath>
    <PgPkgFileName Condition="'$(PgPkgFileName)' == ''">$(MSBuildProjectName)-$(Version).pgpkg</PgPkgFileName>
    <PgPkgFilePath>$(PgPkgOutputPath)$(PgPkgFileName)</PgPkgFilePath>
    <PgPkgSchemaRoot>schema/$(DatabaseName)</PgPkgSchemaRoot>

    <_PgPkgStageDir>$(IntermediateOutputPath)pgpkg-stage\</_PgPkgStageDir>
    <_PgPkgSchemaStageDir>$(_PgPkgStageDir)$(PgPkgSchemaRoot)\</_PgPkgSchemaStageDir>
  </PropertyGroup>

  <!-- ── Standard entry-points ─────────────────────────────────────────────── -->

  <Target Name="Build" DependsOnTargets="CreatePgPkg" />

  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

  <!-- ── CollectPgSchema ───────────────────────────────────────────────────── -->
  <!--  Extension seam: targets using BeforeTargets="CollectPgSchema" may add   -->
  <!--  dynamically-generated files to @(PgSchema) before CreatePgPkg runs.     -->
  <Target Name="CollectPgSchema" />

  <!-- ── CreatePgPkg ──────────────────────────────────────────────────────── -->
  <!--
    Incremental build notes
    ───────────────────────
    Inputs includes:
      • @(PgSchema)               — static SQL/pgschema files declared in the project
      • $(MSBuildProjectFullPath) — triggers rebuild on any project-file change
                                    (version bump, DatabaseName change, new target, etc.)

    For projects that use a BeforeTargets="CollectPgSchema" generator (e.g.
    ExtractEfSchema), also add the generated file as a static <PgSchema> item with
    Condition="Exists(...)" so MSBuild can track it across builds:

        <ItemGroup>
          <PgSchema Include="$(OutputSqlFile)" Condition="Exists('$(OutputSqlFile)')" />
        </ItemGroup>

    On the very first build the Condition is false, so CreatePgPkg always runs.
    On subsequent builds the file exists and MSBuild compares its timestamp to the
    package output — skipping the zip step when nothing has changed.
  -->
  <Target Name="CreatePgPkg"
          DependsOnTargets="CollectPgSchema"
          Inputs="@(PgSchema);$(MSBuildProjectFullPath)"
          Outputs="$(PgPkgFilePath)">

    <Message Text="Creating package: $(PgPkgFilePath)" Importance="high" />

    <MakeDir Directories="$(PgPkgOutputPath)" />

    <RemoveDir Directories="$(_PgPkgStageDir)" />
    <MakeDir   Directories="$(_PgPkgSchemaStageDir)" />

    <Copy SourceFiles="%(PgSchema.FullPath)"
          DestinationFiles="$(_PgPkgSchemaStageDir)%(PgSchema.RecursiveDir)%(PgSchema.Filename)%(PgSchema.Extension)"
          SkipUnchangedFiles="true" />

    <WriteLinesToFile File="$(_PgPkgStageDir)manifest.json"
                      Overwrite="true"
                      Lines='{ "databaseName": "$(DatabaseName)", "version": "$(Version)", "created": "$(MSBuildProjectName)" }' />

    <Delete Files="$(PgPkgFilePath)" />
    <ZipDirectory SourceDirectory="$(_PgPkgStageDir)"
                  DestinationFile="$(PgPkgFilePath)"
                  Overwrite="true" />

    <Message Text="Package written: $(PgPkgFilePath)" Importance="high" />
  </Target>

  <!-- ── Clean ────────────────────────────────────────────────────────────── -->
  <!--
    Deletes the current package AND any leftover .pgpkg files from previous
    versions or DatabaseName values in the same output directory, so a version
    bump never leaves stale artefacts behind.
  -->
  <Target Name="Clean">
    <ItemGroup>
      <_AllPackages Include="$(PgPkgOutputPath)*.pgpkg" />
    </ItemGroup>
    <Delete Files="@(_AllPackages)" />
    <RemoveDir Directories="$(_PgPkgStageDir)" />
  </Target>

  <!-- Expose the package path as a build output for other tooling -->
  <Target Name="GetPgPkgOutputPath" Returns="$(PgPkgFilePath)" />
</Project>
