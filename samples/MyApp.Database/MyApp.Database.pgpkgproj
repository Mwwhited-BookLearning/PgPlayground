<Project Sdk="OoBDev.PgPkg.Sdk/1.0.0" DefaultTargets="Build">

  <PropertyGroup>
    <DatabaseName>myapp</DatabaseName>
    <Version>1.0.0</Version>
    <!-- Schema comes entirely from the EF extraction target below -->
    <EnableDefaultPgSchemaItems>false</EnableDefaultPgSchemaItems>
  </PropertyGroup>

  <PropertyGroup>
    <_SchemaScriptProject>$(MSBuildThisFileDirectory)..\MyApp.Data\SchemaScript\SchemaScript.csproj</_SchemaScriptProject>
    <_EfOutputFile>$(MSBuildThisFileDirectory)schema\001_ef_schema.sql</_EfOutputFile>
  </PropertyGroup>

  <!--
    Declare the generated SQL file as a static PgSchema item (with Exists guard).
    On first build the file does not yet exist so CreatePgPkg always runs.
    On subsequent builds the file is present and MSBuild compares its timestamp
    to the .pgpkg output — skipping the zip step when the EF model has not changed.
  -->
  <ItemGroup>
    <PgSchema Include="$(_EfOutputFile)" Condition="Exists('$(_EfOutputFile)')" />
  </ItemGroup>

  <!--
    ExtractEfSchema runs before CreatePgPkg (via CollectPgSchema).
    It builds and runs SchemaScript — a small console app that calls
    DbContext.GenerateCreateScript() — and adds the output SQL to @(PgSchema).
    No EF migration history is required.
  -->
  <Target Name="ExtractEfSchema" BeforeTargets="CollectPgSchema">

    <Exec Command="dotnet build &quot;$(_SchemaScriptProject)&quot;" />

    <MakeDir Directories="$(MSBuildThisFileDirectory)schema" />

    <Exec Command="dotnet run --project &quot;$(_SchemaScriptProject)&quot; --no-build -- &quot;$(_EfOutputFile)&quot;" />

    <ItemGroup>
      <PgSchema Include="$(_EfOutputFile)" />
    </ItemGroup>

  </Target>

</Project>
